# Build outputs
target/
dist/
node_modules/
*.wasm.map
# Local state of the tools and of runs
.cache/
out/
# Python
__pycache__/
.venv/
bench/web/vendor/
# A running host's address in its project (amoris serve)
.amoris/
# Until no build from before the 2026-10-16 rename runs in this checkout: such hosts' state.
.pocket/
web/pkg/
web/projects/
# Licensed showcase assets are fetched and hash-verified, not vendored into Git.
site/demos/*/models/third-party/
site/demos/stress-*/

# Large audited town-world model is packaged locally.
samples/town-walk/models/third-party/
samples/town-walk/lighting/town-probes.json

# Blender working files are kept locally: each game's build_*.py scripts regenerate its models.
samples/*/art/*.blend
samples/*/art/*.blend1

# Personal environment files (at every depth)
.DS_Store
.vscode/
.obsidian/
.idea/
*.code-workspace
.claude/
.codex/
.opencode/
.omp/
.pi/

# Generated runs and local verification material stay in out/ or CI artifacts.
logs/
*.log
*.tlog
/docs/evidence/
/docs/bench/physics/*.txt
/docs/bench/physics/*.jsonl
/bench/agent-dev/control-results.json
/site/content/evidence/bench/
/site/media/lighting/*-pt-report.json
/samples/town-walk/lighting/bake-report.json
