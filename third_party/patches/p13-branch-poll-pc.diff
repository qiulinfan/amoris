+/* Amoris P13: a jump's poll in JS_CallInternal. When the counter runs out, the frame's PC is first
+   set to the jump (cur_pc - 1 lies inside the jump instruction), so JS_GetStackFrameInfo(0) in the
+   interrupt handler reports the jump, not the frame's last call; then `jump` moves the PC as
+   before, so an interrupt unwinds from the jump's target as it did without the patch. The fast
+   path is the same work (count, compare, jump) in another order. */
+#define BRANCH_POLL(jump)                                       \
+    do {                                                        \
+        if (unlikely(--ctx->interrupt_counter <= 0)) {          \
+            sf->cur_pc = pc;                                    \
+            jump;                                               \
+            if (__js_poll_interrupts(ctx))                      \
+                goto exception;                                 \
+        } else {                                                \
+            jump;                                               \
+        }                                                       \
+    } while (0)
+
 /* return -1 (exception) or true/false */
