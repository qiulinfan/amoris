             if (JS_ToFloat64Free(ctx, &d, val))
@@ -11291,7 +11324,7 @@ static int JS_SetPropertyValue(JSContext *ctx, JSValueConst this_obj,
                 goto ta_immutable;
             if (unlikely(idx >= (uint32_t)p->u.array.count))
                 goto ta_out_of_bound;
-            p->u.array.u.float_ptr[idx] = d;
+            p->u.array.u.float_ptr[idx] = js_canon_f32(d);
             break;
         case JS_CLASS_FLOAT64_ARRAY:
             if (JS_ToFloat64Free(ctx, &d, val)) {
@@ -11313,7 +11346,7 @@ static int JS_SetPropertyValue(JSContext *ctx, JSValueConst this_obj,
                         return JS_ThrowTypeErrorOrFalse(ctx, flags, "out-of-bound numeric index");
                 return true; // per spec: no OOB exception
             }
-            p->u.array.u.double_ptr[idx] = d;
