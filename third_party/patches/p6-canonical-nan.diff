+        *pval = js_float64(js_canon_read(fromfp16(p->u.array.u.fp16_ptr[idx])));
         return true;
     case JS_CLASS_FLOAT32_ARRAY:
         if (unlikely(idx >= p->u.array.count)) return false;
-        *pval = js_float64(p->u.array.u.float_ptr[idx]);
+        *pval = js_float64(js_canon_read(p->u.array.u.float_ptr[idx]));
         return true;
     case JS_CLASS_FLOAT64_ARRAY:
