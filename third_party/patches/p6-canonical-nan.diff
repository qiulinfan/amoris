+            return js_float64(js_canon_read(u.f));
         }
     case JS_CLASS_FLOAT64_ARRAY:
         {
@@ -62762,17 +62795,17 @@ static JSValue js_dataview_setValue(JSContext *ctx,
         if (JS_ToFloat64(ctx, &d, val))
             return JS_EXCEPTION;
         if (class_id == JS_CLASS_FLOAT16_ARRAY) {
-            v = tofp16(d);
+            v = js_canon_fp16(d);
         } else if (class_id == JS_CLASS_FLOAT32_ARRAY) {
             union {
                 float f;
                 uint32_t i;
             } u;
-            u.f = d;
+            u.f = js_canon_f32(d);
