--- a/quickjs/quickjs.c
+++ b/quickjs/quickjs.c
@@ -633,6 +633,39 @@ typedef union JSFloat64Union {
     uint32_t u32[2];
 } JSFloat64Union;
 
+/* Amoris P6: one NaN in typed arrays and DataViews. QuickJS-ng NaN-boxes values only on 32-bit
+   targets, so a 64-bit native build keeps a NaN's sign and payload (0/0 is 0xFFF8000000000000 on
+   x86) where wasm32 has 0x7FF8000000000000, and a script reading a float's bytes through another
+   view would see the difference. Every float store writes the canonical NaN, and a float16 or
+   float32 element read as a number gives the canonical double NaN. */
+static inline double js_canon_f64(double d)
+{
+    JSFloat64Union u;
+    if (!isnan(d))
+        return d;
+    u.u64 = 0x7FF8000000000000ULL;
+    return u.d;
+}
+
+static inline float js_canon_f32(double d)
+{
+    union { float f; uint32_t u32; } u;
+    if (!isnan(d))
+        return (float)d;
+    u.u32 = 0x7FC00000;
+    return u.f;
+}
+
+static inline uint16_t js_canon_fp16(double d)
+{
+    return isnan(d) ? 0x7E00 : tofp16(d);
+}
+
+static inline double js_canon_read(double d)
+{
+    return js_canon_f64(d);
+}
+
 typedef enum {
     JS_WEAK_REF_KIND_MAP,
     JS_WEAK_REF_KIND_WEAK_REF,
@@ -10376,11 +10409,11 @@ static bool js_get_fast_array_element(JSContext *ctx, JSObject *p,
