    JSObjectGetTypedArrayBytesPtr=pocket_JSObjectGetTypedArrayBytesPtr
    JSObjectGetTypedArrayLength
    JSObjectHasProperty
    JSObjectHasPropertyForKey
    JSObjectIsConstructor
    JSObjectIsFunction
    JSObjectMake
    JSObjectMakeArray
    JSObjectMakeArrayBufferWithBytesNoCopy=pocket_JSObjectMakeArrayBufferWithBytesNoCopy
    JSObjectMakeConstructor
    JSObjectMakeDate
    JSObjectMakeDeferredPromise
    JSObjectMakeError
    JSObjectMakeFunction
    JSObjectMakeFunctionWithCallback
    JSObjectMakeRegExp
    JSObjectMakeTypedArray=pocket_JSObjectMakeTypedArray
    JSObjectMakeTypedArrayWithArrayBuffer=pocket_JSObjectMakeTypedArrayWithArrayBuffer
    JSObjectMakeTypedArrayWithArrayBufferAndOffset=pocket_JSObjectMakeTypedArrayWithArrayBufferAndOffset
    JSObjectMakeTypedArrayWithBytesNoCopy=pocket_JSObjectMakeTypedArrayWithBytesNoCopy
    JSObjectSetPrivate
    JSObjectSetProperty
    JSObjectSetPropertyAtIndex
    JSObjectSetPropertyForKey
    JSObjectSetPrototype
    JSPropertyNameAccumulatorAddName
