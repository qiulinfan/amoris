    JSValueCompareInt64
    JSValueCompareUInt64
    JSValueCreateJSONString
    JSValueGetType
    JSValueGetTypedArrayType=pocket_JSValueGetTypedArrayType
    JSValueIsArray
    JSValueIsBigInt
    JSValueIsBoolean
    JSValueIsDate
    JSValueIsEqual
    JSValueIsInstanceOfConstructor
    JSValueIsNull
    JSValueIsNumber
    JSValueIsObject
    JSValueIsObjectOfClass
    JSValueIsStrictEqual
