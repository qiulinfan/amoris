; The JavaScriptCore C API that pocket_jsc.dll exports: every function of JavaScript.h's headers
; (JSBase, JSContextRef, JSObjectRef, JSStringRef, JSTypedArray, JSValueRef), those Bun's build
; calls without the API lock routed through jsc_locks.cpp, and kJSClassDefinitionEmpty.
LIBRARY pocket_jsc
EXPORTS
    JSBigIntCreateWithDouble
    JSBigIntCreateWithInt64
    JSBigIntCreateWithString
    JSBigIntCreateWithUInt64
    JSCheckScriptSyntax=pocket_JSCheckScriptSyntax
    JSClassCreate
    JSClassRelease
    JSClassRetain
    JSContextGetGlobalContext=pocket_JSContextGetGlobalContext
